pid /tmp/nginx.pid;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    client_max_body_size 1m;
    limit_req_zone $binary_remote_addr zone=ingest:10m rate=30r/s;
    access_log /dev/stdout;
    error_log /dev/stderr warn;
    server {
        listen 8443 ssl;
        server_name _;
        ssl_certificate /run/secrets/tls.crt;
        ssl_certificate_key /run/secrets/tls.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        auth_basic "LogShield private dashboard";
        auth_basic_user_file /run/secrets/htpasswd;
        location = /api/health {
            auth_basic off;
            proxy_pass http://api:3000;
        }
        location /api/ingest/ {
            auth_basic off;
            limit_req zone=ingest burst=60 nodelay;
            proxy_pass http://api:3000;
            proxy_set_header Authorization $http_authorization;
        }
        location /api/ {
            proxy_pass http://api:3000;
            proxy_set_header Authorization "Bearer ${LOGSHIELD_VIEWER_TOKEN}";
        }
        location /ws/ {
            proxy_pass http://api:3000;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection upgrade;
            proxy_set_header Authorization "Bearer ${LOGSHIELD_VIEWER_TOKEN}";
            proxy_read_timeout 60s;
        }
        location / {
            root /usr/share/nginx/html;
            try_files $uri $uri/ /index.html;
        }
    }
}
